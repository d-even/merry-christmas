{
  "name": "christmas-aurora",
  "version": "1.0.0",
  "description": "A magical animated Christmas scene for React: aurora borealis, snowfall, a cosy hut, a snowman and Santa flying across the sky.",
  "keywords": [
    "react",
    "christmas",
    "aurora",
    "northern-lights",
    "snow",
    "snowfall",
    "santa",
    "winter",
    "animation",
    "background",
    "canvas",
    "svg"
  ],
  "author": "d-even",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-even/merry-christmas.git"
  },
  "homepage": "https://github.com/d-even/merry-christmas#readme",
  "bugs": {
    "url": "https://github.com/d-even/merry-christmas/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite example",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:example": "vite build example",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node \"C:/Program Files/nodejs/node_modules/npm/bin/npm-cli.js\" run typecheck && node \"C:/Program Files/nodejs/node_modules/npm/bin/npm-cli.js\" run test && node \"C:/Program Files/nodejs/node_modules/npm/bin/npm-cli.js\" run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
